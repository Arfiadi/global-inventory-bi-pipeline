  <step>
    <name>jumlah IN dan OUT</name>
    <type>Janino</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>jumlah_masuk</field_name>
      <formula_string>JenisTrans.contains("(IN)") ? Jumlah : 0</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>jumlah_keluar</field_name>
      <formula_string>(JenisTrans.contains("(OUT)") || JenisTrans.contains("(ADJ)")) ? Jumlah : 0</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
